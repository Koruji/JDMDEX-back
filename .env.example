# ===========================================
# Server Configuration
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# MariaDB Configuration
# ===========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=jdmdex
MYSQL_USER=jdmdex_user
MYSQL_PASSWORD=jdmdex_pass
MYSQL_ROOT_PASSWORD=rootpassword

# ===========================================
# JWT Configuration
# ===========================================
# Secret key for JWT tokens (change this in production!)
JWT_SECRET=supersecretjdmdexkey12345
# Token expiration time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# ===========================================
# Bunny CDN Configuration
# ===========================================
# Bunny Storage API Key (required)
BUNNY_API_KEY=your_bunny_storage_api_key_here
# Storage Zone Name (default: jdmdex)
BUNNY_STORAGE_ZONE=jdmdex
# Pull Zone Domain (default: jdmdex-cdn.loocist23.fr)
BUNNY_PULL_ZONE=jdmdex-cdn.loocist23.fr

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=10485760
