# ===========================================
# JDMDex API - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# These are the variables needed for the application to run
#
# For GitHub Actions CI/CD, set these as Secrets in:
# Settings > Secrets > Actions > New repository secret
# ===========================================

# ===========================================
# Server Configuration
# ===========================================
PORT=3000
NODE_ENV=production

# ===========================================
# MariaDB / MySQL Configuration
# ===========================================
# Database host (use 'localhost' if running on same server)
MYSQL_HOST=localhost
# Database port
MYSQL_PORT=3306
# Database name
MYSQL_DATABASE=jdmdex
# Database user
MYSQL_USER=jdmdex_user
# Database password
MYSQL_PASSWORD=your_secure_password_here
# Root password (for migrations)
MYSQL_ROOT_PASSWORD=your_root_password_here

# ===========================================
# JWT Authentication Configuration
# ===========================================
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_strong_jwt_secret_here_change_this
# Token expiration (1h, 24h, 7d, etc.)
JWT_EXPIRES_IN=24h

# ===========================================
# File Upload Configuration
# ===========================================
# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
# Upload directory
UPLOAD_DIR=./uploads

# ===========================================
# Bunny CDN Configuration
# ===========================================
# Get your API key from Bunny.net dashboard > Storage > API Keys
BUNNY_API_KEY=your_bunny_cdn_api_key_here
# Your storage zone name
BUNNY_STORAGE_ZONE=jdmdex
# Your pull zone domain (e.g., jdmdex-cdn.yourdomain.com)
BUNNY_PULL_ZONE=jdmdex-cdn.loocist23.fr

# ===========================================
# Logging Configuration (Optional)
# ===========================================
# Directory for log files
LOG_DIR=./logs
# Log file path
LOG_FILE=./logs/api-errors.log
# Log level: error, warn, info, debug
LOG_LEVEL=error

# ===========================================
# GitHub Actions CI/CD Secrets Required
# ===========================================
# Set these in GitHub: Settings > Secrets > Actions
#
# VPS Connection:
# VPS_HOST=your-vps-ip-or-domain.com
# VPS_USERNAME=your-ssh-username
# VPS_SSH_KEY=your-private-ssh-key (full content including -----BEGIN PRIVATE KEY-----)
# VPS_PORT=22 (default, change if using custom port)
#
# All the variables above (PORT, NODE_ENV, MYSQL_*, JWT_*, BUNNY_*, etc.)
# must also be set as GitHub Secrets with the same names
#
# Note: For the SSH key, use: cat ~/.ssh/id_rsa | pbcopy (Mac) or cat ~/.ssh/id_rsa (Linux)
